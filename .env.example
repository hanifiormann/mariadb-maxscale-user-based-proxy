# Kopyalayın: cp .env.example .env  (.env git'e girmez)

# DB sunucusu (container'ların çalıştığı makine)
DB_HOST=192.0.2.10

# Proxy sunucusu (MaxScale)
PROXY_HOST=192.0.2.20
PROXY_PORT=4006

# Container root şifresi
ROOTPASS=change_me_root

# MaxScale servis + monitör hesabı (proxy/maxscale.cnf ile aynı olmalı)
MAXUSER=maxscale
MAXPASS=change_me_maxscale

# Uygulama kullanıcıları
APPPASS=change_me_app
APPUSERS="1eski 2eski 1yeni 2yeni"
DB=testdb
